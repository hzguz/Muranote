{
  "name": "muranote",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first sticky-note wall with columns, reminders and Firestore sync.",
  "license": "MIT",
  "author": {
    "name": "Gustavo Soares",
    "url": "https://gustasoares.com"
  },
  "homepage": "https://muranote.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzguz/Muranote.git"
  },
  "bugs": {
    "url": "https://github.com/hzguz/Muranote/issues"
  },
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check:unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test:rules": "npx -y firebase-tools@14 emulators:exec --only firestore --project demo-muranote \"node --test tests/firestore.rules.test.mjs\"",
    "preview": "vite preview",
    "admin:claim": "node scripts/setAdminClaim.mjs",
    "security:secrets": "node scripts/checkTrackedSecrets.mjs",
    "security:audit": "yarn audit --groups dependencies",
    "security:audit:all": "yarn audit",
    "check:prepublish": "yarn typecheck && yarn build && yarn check:unused && yarn security:secrets && yarn security:audit"
  },
  "dependencies": {
    "dompurify": "^3.3.1",
    "firebase": "^12.6.0",
    "framer-motion": "^12.23.26",
    "lucide-react": "^1.8.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-admin": "^13.8.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
