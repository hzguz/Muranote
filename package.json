{
  "name": "muranote",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check:unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "preview": "vite preview",
    "admin:claim": "node scripts/setAdminClaim.mjs",
    "security:secrets": "node scripts/checkTrackedSecrets.mjs",
    "security:audit": "yarn audit --groups dependencies",
    "security:audit:all": "yarn audit",
    "check:prepublish": "yarn typecheck && yarn build && yarn check:unused && yarn security:secrets && yarn security:audit"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.3.1",
    "firebase": "^12.6.0",
    "framer-motion": "^12.23.26",
    "lucide-react": "^1.8.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tabler-icons-react": "^1.56.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-admin": "^13.8.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
